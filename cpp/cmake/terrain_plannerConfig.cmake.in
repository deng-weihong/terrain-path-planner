@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Eigen3 3.3 NO_MODULE)
find_path(TERRAIN_PLANNER_JSON_INCLUDE_DIR nlohmann/json.hpp REQUIRED)
include("${CMAKE_CURRENT_LIST_DIR}/terrain_plannerTargets.cmake")
set_property(TARGET terrain_planner::terrain_planner_json APPEND PROPERTY
  INTERFACE_INCLUDE_DIRECTORIES "${TERRAIN_PLANNER_JSON_INCLUDE_DIR}")
check_required_components(terrain_planner)
